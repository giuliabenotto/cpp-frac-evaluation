        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">Joint occurrence count fxy for the defined counting space.</rdfs:comment>
        <rdfs:label xml:lang="en">co-occurrence count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#logDice -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#logDice">
