@prefix : <https://example.org/cpp-eval/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix collscore: <https://ilc.cnr.it/klab/ontology/cooccurrence-measures#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:rain a frac:Observable ; rdfs:label "rain"@en .
:heavy a frac:Observable ; rdfs:label "heavy"@en .
:torrential a frac:Observable ; rdfs:label "torrential"@en .
:steady a frac:Observable ; rdfs:label "steady"@en .
:persistent a frac:Observable ; rdfs:label "persistent"@en .
:light a frac:Observable ; rdfs:label "light"@en .
:driving a frac:Observable ; rdfs:label "driving"@en .
:freezing a frac:Observable ; rdfs:label "freezing"@en .
:intense a frac:Observable ; rdfs:label "intense"@en .
:continuous a frac:Observable ; rdfs:label "continuous"@en .
:moderate a frac:Observable ; rdfs:label "moderate"@en .
:incessant a frac:Observable ; rdfs:label "incessant"@en .
:prolonged a frac:Observable ; rdfs:label "prolonged"@en .
:widespread a frac:Observable ; rdfs:label "widespread"@en .
:intermittent a frac:Observable ; rdfs:label "intermittent"@en .
:relentless a frac:Observable ; rdfs:label "relentless"@en .
:soaking a frac:Observable ; rdfs:label "soaking"@en .
:frequent a frac:Observable ; rdfs:label "frequent"@en .
:occasional a frac:Observable ; rdfs:label "occasional"@en .
:scattered a frac:Observable ; rdfs:label "scattered"@en .
:patchy a frac:Observable ; rdfs:label "patchy"@en .
:gentle a frac:Observable ; rdfs:label "gentle"@en .
:seasonal a frac:Observable ; rdfs:label "seasonal"@en .
:tropical a frac:Observable ; rdfs:label "tropical"@en .
:autumnal a frac:Observable ; rdfs:label "autumnal"@en .

:Corpus_A a prov:Entity ; rdfs:label "English synthetic corpus snapshot A"@en ; prov:atLocation "corpus/corpus_a.txt" ; dct:description "Deterministically generated evaluation corpus with 17616 sentences and 171736 word tokens."@en .
:Corpus_B a prov:Entity ; rdfs:label "English synthetic corpus snapshot B"@en ; prov:atLocation "corpus/corpus_b.txt" ; dct:description "Deterministically generated evaluation corpus with 17620 sentences and 171764 word tokens."@en .

# Run r1 -- Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern ADJ NOUN; logDice; Extractor v1.
:obs_r1_heavy a frac:Collocation ;
    frac:head :rain ; rdfs:member :rain, :heavy ; frac:observedIn :Corpus_A ;
    collscore:logDice "9.62"^^xsd:decimal ;
    dct:description "Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern ADJ NOUN; logDice; Extractor v1."@en .
:obs_r1_torrential a frac:Collocation ;
    frac:head :rain ; rdfs:member :rain, :torrential ; frac:observedIn :Corpus_A ;
    collscore:logDice "9.31"^^xsd:decimal ;
    dct:description "Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern ADJ NOUN; logDice; Extractor v1."@en .
:obs_r1_intermittent a frac:Collocation ;
    frac:head :rain ; rdfs:member :rain, :intermittent ; frac:observedIn :Corpus_A ;
    collscore:logDice "7.25"^^xsd:decimal ;
    dct:description "Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern ADJ NOUN; logDice; Extractor v1."@en .
:obs_r1_soaking a frac:Collocation ;
    frac:head :rain ; rdfs:member :rain, :soaking ; frac:observedIn :Corpus_A ;
    collscore:logDice "6.87"^^xsd:decimal ;
    dct:description "Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern ADJ NOUN; logDice; Extractor v1."@en .
:obs_r1_seasonal a frac:Collocation ;
    frac:head :rain ; rdfs:member :rain, :seasonal ; frac:observedIn :Corpus_A ;
    collscore:logDice "5.34"^^xsd:decimal ;
    dct:description "Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern ADJ NOUN; logDice; Extractor v1."@en .

