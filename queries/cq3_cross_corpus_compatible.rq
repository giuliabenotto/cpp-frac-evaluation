PREFIX collscore: <https://ilc.cnr.it/klab/ontology/cooccurrence-measures#>
PREFIX : <https://example.org/cpp-eval/>
PREFIX cpp: <https://ilc.cnr.it/klab/ontology/cpp#>
PREFIX frac: <http://www.w3.org/ns/lemon/frac#>
PREFIX lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX p-plan: <http://purl.org/net/p-plan#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?collocate ?runA ?runB ?scoreA ?scoreB (?scoreB - ?scoreA AS ?delta)
WHERE {
  VALUES ?parameter {
    cpp:windowLeft cpp:windowRight cpp:sentenceBoundary cpp:ordered cpp:minimumFrequency
  }

  ?observationA a frac:Collocation ;
      frac:head :crime ; rdfs:member :crime, ?collocate ;
      frac:observedIn :Corpus_A ; collscore:logDice ?scoreA ;
      prov:wasGeneratedBy ?runA .
  ?observationB a frac:Collocation ;
      frac:head :crime ; rdfs:member :crime, ?collocate ;
      frac:observedIn :Corpus_B ; collscore:logDice ?scoreB ;
      prov:wasGeneratedBy ?runB .
  FILTER (?collocate != :crime)

  ?runA p-plan:correspondsToStep cpp:extractCollocations ;
      prov:wasAssociatedWith ?software ;
      prov:used :Corpus_A, ?indexA .
  ?runB p-plan:correspondsToStep cpp:extractCollocations ;
      prov:wasAssociatedWith ?software ;
      prov:used :Corpus_B, ?indexB .
  ?software a prov:SoftwareAgent .

  ?indexA p-plan:correspondsToVariable cpp:index ; prov:wasDerivedFrom :Corpus_A .
  ?indexB p-plan:correspondsToVariable cpp:index ; prov:wasDerivedFrom :Corpus_B .

  ?runA prov:used [ p-plan:correspondsToVariable ?parameter ; prov:value ?valueA ] .
  ?runB prov:used [ p-plan:correspondsToVariable ?parameter ; prov:value ?valueB ] .
  FILTER (?valueA = ?valueB)

  ?runA prov:used [ p-plan:correspondsToVariable cpp:posPattern ; rdf:_1 ?pos1 ; rdf:_2 ?pos2 ] .
  ?runB prov:used [ p-plan:correspondsToVariable cpp:posPattern ; rdf:_1 ?pos1 ; rdf:_2 ?pos2 ] .

  ?runA prov:used [ p-plan:correspondsToVariable cpp:measures ; rdfs:member collscore:LogDice ] .
  ?runB prov:used [ p-plan:correspondsToVariable cpp:measures ; rdfs:member collscore:LogDice ] .
}
GROUP BY ?collocate ?runA ?runB ?scoreA ?scoreB
HAVING (COUNT(DISTINCT ?parameter) = 5)
ORDER BY ?collocate ?runA ?runB
