        <rdfs:comment xml:lang="en">A finite numeric score represented as xsd:decimal; undefined or infinite values must not be forced into this datatype.</rdfs:comment>
        <rdfs:label xml:lang="en">score numeric value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#tScore -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#tScore">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/lemon/frac#cScore"/>
