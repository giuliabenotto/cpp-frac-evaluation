        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Evert2005"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Rychly2008"/>
        <rdfs:comment xml:lang="en">Locally declared FrAC-compatible datatype score property; absent from LexInfo. See its named measure resource for the precise formula and references.</rdfs:comment>
        <rdfs:label xml:lang="it">Misura associativa logDice</rdfs:label>
        <rdfs:label xml:lang="en">logDice association score</rdfs:label>
        <denotesMeasure rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#LogDice"/>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#logLikelihood -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#logLikelihood">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/lemon/frac#cScore"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Dunning1993"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Evert2005"/>
        <rdfs:comment xml:lang="en">Locally declared FrAC-compatible datatype score property; absent from LexInfo. See its named measure resource for the precise formula and references.</rdfs:comment>
        <rdfs:label xml:lang="en">Log-likelihood ratio statistic (G-squared)</rdfs:label>
        <rdfs:label xml:lang="it">Statistica del rapporto di verosimiglianza (G quadro)</rdfs:label>
        <denotesMeasure rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#LogLikelihood"/>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#pmi -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#pmi">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/lemon/frac#cScore"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#ChurchHanks1990"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Evert2005"/>
        <rdfs:comment xml:lang="en">Locally declared FrAC-compatible datatype score property; absent from LexInfo. See its named measure resource for the precise formula and references.</rdfs:comment>
        <rdfs:label xml:lang="it">Informazione mutua puntuale</rdfs:label>
        <rdfs:label xml:lang="en">Pointwise mutual information</rdfs:label>
        <denotesMeasure rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#PMI"/>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#pmi2 -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#pmi2">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/lemon/frac#cScore"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Daille1994"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Evert2005"/>
        <rdfs:comment xml:lang="en">Locally declared FrAC-compatible datatype score property; absent from LexInfo. See its named measure resource for the precise formula and references.</rdfs:comment>
        <rdfs:label xml:lang="it">PMI a frequenza congiunta quadrata (PMI2)</rdfs:label>
        <rdfs:label xml:lang="en">Squared-frequency PMI (PMI2)</rdfs:label>
        <denotesMeasure rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#PMI2"/>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#pmi3 -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#pmi3">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/lemon/frac#cScore"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Daille1994"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Evert2005"/>
        <rdfs:comment xml:lang="en">Locally declared FrAC-compatible datatype score property; absent from LexInfo. See its named measure resource for the precise formula and references.</rdfs:comment>
        <rdfs:label xml:lang="en">Cubed-frequency PMI (PMI3)</rdfs:label>
        <rdfs:label xml:lang="it">PMI a frequenza congiunta cubica (PMI3)</rdfs:label>
        <denotesMeasure rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#PMI3"/>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#relativeFrequency -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#relativeFrequency">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/lemon/frac#cScore"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Evert2005"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#FrAC2025"/>
        <rdfs:comment xml:lang="en">Locally declared FrAC-compatible datatype score property; absent from LexInfo. See its named measure resource for the precise formula and references.</rdfs:comment>
        <rdfs:label xml:lang="it">Frequenza relativa di co-occorrenza</rdfs:label>
        <rdfs:label xml:lang="en">Relative co-occurrence frequency</rdfs:label>
        <denotesMeasure rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#RelativeFrequency"/>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#sampleSize -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#sampleSize">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceCountData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">Number N of elementary opportunities consistent with the joint and marginal counts (not unconditionally the corpus token count).</rdfs:comment>
        <rdfs:label xml:lang="en">number of observation opportunities</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#scoreNumericValue -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#scoreNumericValue">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#ScoreResult"/>
