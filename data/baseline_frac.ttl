@prefix : <https://example.org/cpp-eval/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix collscore: <https://ilc.cnr.it/klab/ontology/cooccurrence-measures#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:crime a frac:Observable ; rdfs:label "crime"@en .
:commit a frac:Observable ; rdfs:label "commit"@en .
:report a frac:Observable ; rdfs:label "report"@en .
:examine a frac:Observable ; rdfs:label "examine"@en .
:identify a frac:Observable ; rdfs:label "identify"@en .
:trace a frac:Observable ; rdfs:label "trace"@en .
:detect a frac:Observable ; rdfs:label "detect"@en .
:witness a frac:Observable ; rdfs:label "witness"@en .
:prosecute a frac:Observable ; rdfs:label "prosecute"@en .
:punish a frac:Observable ; rdfs:label "punish"@en .
:conceal a frac:Observable ; rdfs:label "conceal"@en .
:organise a frac:Observable ; rdfs:label "organise"@en .
:plan a frac:Observable ; rdfs:label "plan"@en .
:admit a frac:Observable ; rdfs:label "admit"@en .
:investigate a frac:Observable ; rdfs:label "investigate"@en .
:expose a frac:Observable ; rdfs:label "expose"@en .
:prevent a frac:Observable ; rdfs:label "prevent"@en .
:combat a frac:Observable ; rdfs:label "combat"@en .
:reduce a frac:Observable ; rdfs:label "reduce"@en .
:record a frac:Observable ; rdfs:label "record"@en .
:discuss a frac:Observable ; rdfs:label "discuss"@en .
:analyse a frac:Observable ; rdfs:label "analyse"@en .
:solve a frac:Observable ; rdfs:label "solve"@en .
:mention a frac:Observable ; rdfs:label "mention"@en .
:classify a frac:Observable ; rdfs:label "classify"@en .

:Corpus_A a prov:Entity ; rdfs:label "English synthetic corpus snapshot A"@en ; prov:atLocation "corpus/corpus_a.txt" ; dct:description "Deterministically generated evaluation corpus with 17616 sentences and 165477 word tokens."@en .
:Corpus_B a prov:Entity ; rdfs:label "English synthetic corpus snapshot B"@en ; prov:atLocation "corpus/corpus_b.txt" ; dct:description "Deterministically generated evaluation corpus with 17620 sentences and 165525 word tokens."@en .

# Run r1 -- Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern VERB NOUN; logDice; Extractor v1.
:obs_r1_heavy a frac:Collocation ;
    frac:head :crime ; rdfs:member :crime, :commit ; frac:observedIn :Corpus_A ;
    collscore:logDice "9.62"^^xsd:decimal ;
    dct:description "Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern VERB NOUN; logDice; Extractor v1."@en .
:obs_r1_torrential a frac:Collocation ;
    frac:head :crime ; rdfs:member :crime, :report ; frac:observedIn :Corpus_A ;
    collscore:logDice "9.31"^^xsd:decimal ;
    dct:description "Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern VERB NOUN; logDice; Extractor v1."@en .
:obs_r1_intermittent a frac:Collocation ;
    frac:head :crime ; rdfs:member :crime, :investigate ; frac:observedIn :Corpus_A ;
    collscore:logDice "7.25"^^xsd:decimal ;
    dct:description "Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern VERB NOUN; logDice; Extractor v1."@en .
:obs_r1_soaking a frac:Collocation ;
    frac:head :crime ; rdfs:member :crime, :prevent ; frac:observedIn :Corpus_A ;
    collscore:logDice "6.87"^^xsd:decimal ;
    dct:description "Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern VERB NOUN; logDice; Extractor v1."@en .
:obs_r1_seasonal a frac:Collocation ;
    frac:head :crime ; rdfs:member :crime, :solve ; frac:observedIn :Corpus_A ;
    collscore:logDice "5.34"^^xsd:decimal ;
    dct:description "Symmetric 5-token window; sentence-bounded; unordered; minimum frequency 3; POS pattern VERB NOUN; logDice; Extractor v1."@en .

