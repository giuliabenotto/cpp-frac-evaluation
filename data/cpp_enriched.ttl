# CPP plan and shared variables
cpp:collocationExtractionPlan a p-plan:Plan .
cpp:extractCollocations a p-plan:Step ;
    p-plan:isStepOfPlan cpp:collocationExtractionPlan ;
    p-plan:hasInputVar cpp:corpus, cpp:index, cpp:windowLeft, cpp:windowRight,
        cpp:sentenceBoundary, cpp:ordered, cpp:minimumFrequency, cpp:posPattern, cpp:measures ;
    p-plan:hasOutputVar cpp:collocationObservation .

cpp:corpus a p-plan:Variable ; rdfs:label "corpus"@en .
cpp:index a p-plan:Variable ; rdfs:label "index"@en .
cpp:windowLeft a p-plan:Variable ; rdfs:label "left context window"@en .
cpp:windowRight a p-plan:Variable ; rdfs:label "right context window"@en .
cpp:sentenceBoundary a p-plan:Variable ; rdfs:label "sentence boundary"@en .
cpp:ordered a p-plan:Variable ; rdfs:label "ordered co-occurrence"@en .
cpp:minimumFrequency a p-plan:Variable ; rdfs:label "minimum co-occurrence frequency"@en .
cpp:posPattern a p-plan:Variable ; rdfs:label "part-of-speech pattern"@en .
cpp:measures a p-plan:Variable ; rdfs:label "association measures"@en .
cpp:collocationObservation a p-plan:Variable ; rdfs:label "collocation observation"@en .

# Corpus and index bindings
:Corpus_A a p-plan:Entity ; p-plan:correspondsToVariable cpp:corpus .
:Index_A a p-plan:Entity, prov:Entity ; p-plan:correspondsToVariable cpp:index ; prov:wasDerivedFrom :Corpus_A ; rdfs:label "Index built from Corpus A"@en .
:Corpus_B a p-plan:Entity ; p-plan:correspondsToVariable cpp:corpus .
:Index_B a p-plan:Entity, prov:Entity ; p-plan:correspondsToVariable cpp:index ; prov:wasDerivedFrom :Corpus_B ; rdfs:label "Index built from Corpus B"@en .

# Software and human agents
:Extractor_v1 a prov:SoftwareAgent ; rdfs:label "Collocation Extractor v1"@en .
:Extractor_v2 a prov:SoftwareAgent ; rdfs:label "Collocation Extractor v2"@en .
:Lexicographer_A a prov:Person ; rdfs:label "Lexicographer A"@en .
:Lexicographer_B a prov:Person ; rdfs:label "Lexicographer B"@en .
:Lexicographer_C a prov:Person ; rdfs:label "Lexicographer C"@en .

# Shared parameter entities
:windowLeft_5 a p-plan:Entity ; p-plan:correspondsToVariable cpp:windowLeft ; prov:value "5"^^xsd:integer .
:windowRight_5 a p-plan:Entity ; p-plan:correspondsToVariable cpp:windowRight ; prov:value "5"^^xsd:integer .
:windowLeft_10 a p-plan:Entity ; p-plan:correspondsToVariable cpp:windowLeft ; prov:value "10"^^xsd:integer .
:windowRight_10 a p-plan:Entity ; p-plan:correspondsToVariable cpp:windowRight ; prov:value "10"^^xsd:integer .
:sentenceBoundary_true a p-plan:Entity ; p-plan:correspondsToVariable cpp:sentenceBoundary ; prov:value true .
:ordered_false a p-plan:Entity ; p-plan:correspondsToVariable cpp:ordered ; prov:value false .
:minimumFrequency_3 a p-plan:Entity ; p-plan:correspondsToVariable cpp:minimumFrequency ; prov:value "3"^^xsd:integer .
:minimumFrequency_10 a p-plan:Entity ; p-plan:correspondsToVariable cpp:minimumFrequency ; prov:value "10"^^xsd:integer .
:posPattern_VERB_NOUN a p-plan:Entity, rdf:Seq ; p-plan:correspondsToVariable cpp:posPattern ; rdf:_1 lexinfo:verb ; rdf:_2 lexinfo:noun .
:measure_logDice a p-plan:Entity, rdf:Bag ; p-plan:correspondsToVariable cpp:measures ; rdfs:member collscore:LogDice .

# Runs
:r1 a p-plan:Activity, prov:Activity ; p-plan:correspondsToStep cpp:extractCollocations ;
    prov:used :Corpus_A, :Index_A, :windowLeft_5, :windowRight_5, :sentenceBoundary_true, :ordered_false, :minimumFrequency_3, :posPattern_VERB_NOUN, :measure_logDice ;
    prov:wasAssociatedWith :Extractor_v1, :Lexicographer_A ;
    prov:generated :obs_r1_commit, :obs_r1_report, :obs_r1_investigate, :obs_r1_prevent, :obs_r1_solve .
:r2 a p-plan:Activity, prov:Activity ; p-plan:correspondsToStep cpp:extractCollocations ;
    prov:used :Corpus_A, :Index_A, :windowLeft_10, :windowRight_10, :sentenceBoundary_true, :ordered_false, :minimumFrequency_3, :posPattern_VERB_NOUN, :measure_logDice ;
    prov:wasAssociatedWith :Extractor_v1, :Lexicographer_B ;
    prov:generated :obs_r2_commit, :obs_r2_report, :obs_r2_investigate, :obs_r2_prevent, :obs_r2_solve .
:r3 a p-plan:Activity, prov:Activity ; p-plan:correspondsToStep cpp:extractCollocations ;
    prov:used :Corpus_B, :Index_B, :windowLeft_5, :windowRight_5, :sentenceBoundary_true, :ordered_false, :minimumFrequency_3, :posPattern_VERB_NOUN, :measure_logDice ;
    prov:wasAssociatedWith :Extractor_v1, :Lexicographer_A ;
    prov:generated :obs_r3_commit, :obs_r3_report, :obs_r3_investigate, :obs_r3_prevent, :obs_r3_solve .
:r4 a p-plan:Activity, prov:Activity ; p-plan:correspondsToStep cpp:extractCollocations ;
    prov:used :Corpus_B, :Index_B, :windowLeft_10, :windowRight_10, :sentenceBoundary_true, :ordered_false, :minimumFrequency_3, :posPattern_VERB_NOUN, :measure_logDice ;
    prov:wasAssociatedWith :Extractor_v1, :Lexicographer_B ;
    prov:generated :obs_r4_commit, :obs_r4_report, :obs_r4_investigate, :obs_r4_prevent, :obs_r4_solve .
:r5 a p-plan:Activity, prov:Activity ; p-plan:correspondsToStep cpp:extractCollocations ;
    prov:used :Corpus_A, :Index_A, :windowLeft_5, :windowRight_5, :sentenceBoundary_true, :ordered_false, :minimumFrequency_10, :posPattern_VERB_NOUN, :measure_logDice ;
    prov:wasAssociatedWith :Extractor_v1, :Lexicographer_C ;
    prov:generated :obs_r5_commit, :obs_r5_report, :obs_r5_investigate, :obs_r5_prevent .
:r6 a p-plan:Activity, prov:Activity ; p-plan:correspondsToStep cpp:extractCollocations ;
    prov:used :Corpus_B, :Index_B, :windowLeft_5, :windowRight_5, :sentenceBoundary_true, :ordered_false, :minimumFrequency_3, :posPattern_VERB_NOUN, :measure_logDice ;
    prov:wasAssociatedWith :Extractor_v2, :Lexicographer_A ;
    prov:generated :obs_r6_commit, :obs_r6_report, :obs_r6_investigate, :obs_r6_prevent, :obs_r6_solve .
:r7 a p-plan:Activity, prov:Activity ; p-plan:correspondsToStep cpp:extractCollocations ;
    prov:used :Corpus_A, :Index_A, :windowLeft_5, :sentenceBoundary_true, :ordered_false, :minimumFrequency_3, :posPattern_VERB_NOUN, :measure_logDice ;
    prov:wasAssociatedWith :Extractor_v1, :Lexicographer_B ;
    prov:generated :obs_r7_commit, :obs_r7_report, :obs_r7_investigate, :obs_r7_prevent, :obs_r7_solve .
:r8 a p-plan:Activity, prov:Activity ; p-plan:correspondsToStep cpp:extractCollocations ;
    prov:used :Corpus_B, :Index_B, :windowLeft_5, :windowRight_5, :sentenceBoundary_true, :ordered_false, :minimumFrequency_10, :posPattern_VERB_NOUN, :measure_logDice ;
    prov:wasAssociatedWith :Extractor_v1, :Lexicographer_C ;
    prov:generated :obs_r8_commit, :obs_r8_report, :obs_r8_investigate, :obs_r8_prevent .

# Link each observation to the run that generated it
:obs_r1_commit prov:wasGeneratedBy :r1 .
:obs_r1_report prov:wasGeneratedBy :r1 .
:obs_r1_investigate prov:wasGeneratedBy :r1 .
:obs_r1_prevent prov:wasGeneratedBy :r1 .
:obs_r1_solve prov:wasGeneratedBy :r1 .
:obs_r2_commit prov:wasGeneratedBy :r2 .
:obs_r2_report prov:wasGeneratedBy :r2 .
