    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/identifier -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/references -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/references"/>
    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#related -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#related"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#scopeNote -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#assumptions -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#assumptions">
        <rdfs:comment xml:lang="en">Conditions that must hold for the formula and interpretation to be valid.</rdfs:comment>
        <rdfs:label xml:lang="en">assumptions</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#computationNote -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#computationNote">
        <rdfs:comment xml:lang="en">Implementation-specific considerations affecting comparability and numerical results.</rdfs:comment>
        <rdfs:label xml:lang="en">computationNote</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#countingSpaceNote -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#countingSpaceNote">
        <rdfs:comment xml:lang="en">Guidance for defining observation space consistently across counts.</rdfs:comment>
        <rdfs:label xml:lang="en">countingSpaceNote</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#denotesMeasure -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#denotesMeasure">
        <rdfs:comment xml:lang="en">Maps a datatype property for collocation scores to its corresponding named measure individual.</rdfs:comment>
        <rdfs:label xml:lang="en">denotesMeasure</rdfs:label>
        <skos:scopeNote xml:lang="en">OWL annotation property deliberately used to describe a datatype property without treating that property as an OWL individual; not an owl:ObjectProperty.</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#edgeCases -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#edgeCases">
        <rdfs:comment xml:lang="en">Undefined cases, zero handling or other boundary behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">edgeCases</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#formulaConvention -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#formulaConvention">
        <rdfs:comment xml:lang="en">States the exact convention, including count/probability normalization and logarithm base.</rdfs:comment>
        <rdfs:label xml:lang="en">formulaConvention</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#formulaLaTeX -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#formulaLaTeX">
        <rdfs:comment xml:lang="en">Human-readable LaTeX expression of the selected mathematical convention.</rdfs:comment>
        <rdfs:label xml:lang="en">formulaLaTeX</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#formulaPlain -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#formulaPlain">
        <rdfs:comment xml:lang="en">Unambiguous plain-text mathematical expression for implementation documentation; not an executable formula language.</rdfs:comment>
        <rdfs:label xml:lang="en">formulaPlain</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#interpretation -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#interpretation">
        <rdfs:comment xml:lang="en">How the computed value should be interpreted in linguistic/statistical analysis.</rdfs:comment>
        <rdfs:label xml:lang="en">interpretation</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#logarithmBase -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#logarithmBase">
        <rdfs:comment xml:lang="en">Logarithm base used by the defined formula; use 2 or natural log e.</rdfs:comment>
        <rdfs:label xml:lang="en">logarithmBase</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#scoreProperty -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#scoreProperty">
        <rdfs:comment xml:lang="en">Maps a named measure individual to the numeric OWL datatype property for direct FrAC scoring.</rdfs:comment>
        <rdfs:label xml:lang="en">scoreProperty</rdfs:label>
        <skos:scopeNote xml:lang="en">OWL annotation property from the named measure individual to its score datatype property; not an owl:ObjectProperty.</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#symbol -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#symbol">
        <rdfs:comment xml:lang="en">Mathematical symbol identifying a variable.</rdfs:comment>
        <rdfs:label xml:lang="en">symbol</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#valueRange -->

    <owl:AnnotationProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#valueRange">
        <rdfs:comment xml:lang="en">Typical or mathematical range for the standard score, given the validity assumptions.</rdfs:comment>
        <rdfs:label xml:lang="en">valueRange</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#hasCountData -->

    <owl:ObjectProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#hasCountData">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#ScoreResult"/>
        <rdfs:range rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceCountData"/>
        <rdfs:comment xml:lang="en">Links a score to the count data from which it can be reproduced.</rdfs:comment>
        <rdfs:label xml:lang="en">has count data</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#hasScoreResult -->

    <owl:ObjectProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#hasScoreResult">
        <owl:inverseOf rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#scoreFor"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:range rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#ScoreResult"/>
        <rdfs:comment xml:lang="en">Connects a FrAC collocation to an individually identifiable measured score.</rdfs:comment>
        <rdfs:label xml:lang="en">has score result</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#referenceUnit -->

    <owl:ObjectProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#referenceUnit">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#ScoreResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/lemon/frac#Observable"/>
        <rdfs:comment xml:lang="en">Per-score directional reference (node or antecedent), avoiding the single-head limitation when different scores on one collocation have different reference units.</rdfs:comment>
        <rdfs:label xml:lang="en">reference unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#requiresInput -->

    <owl:ObjectProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#requiresInput">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceMeasure"/>
        <rdfs:range rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#InputQuantity"/>
        <rdfs:comment xml:lang="en">Declares a formula input variable required to compute a statistical measure.</rdfs:comment>
        <rdfs:label xml:lang="en">requires input</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#scoreFor -->

    <owl:ObjectProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#scoreFor">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#ScoreResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:comment xml:lang="en">Identifies the FrAC collocation quantified by a score result.</rdfs:comment>
        <rdfs:label xml:lang="en">score for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#selectsMeasure -->

    <owl:ObjectProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#selectsMeasure">
        <rdfs:range rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceMeasure"/>
        <rdfs:comment xml:lang="en">Connects a workflow configuration or p-plan:Entity to an association-measure identifier; no restrictive domain is imposed.</rdfs:comment>
        <rdfs:label xml:lang="en">selects measure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#usesMeasure -->

    <owl:ObjectProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#usesMeasure">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#ScoreResult"/>
        <rdfs:range rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceMeasure"/>
        <rdfs:comment xml:lang="en">Identifies the mathematical measure according to which a score result was computed.</rdfs:comment>
        <rdfs:label xml:lang="en">uses measure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/lemon/frac#cScore -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/lemon/frac#cScore"/>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#cell00 -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#cell00">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceCountData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">Observed frequency O_00 in the 2x2 contingency table.</rdfs:comment>
        <rdfs:label xml:lang="en">observed cell 00</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#cell01 -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#cell01">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceCountData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">Observed frequency O_01 in the 2x2 contingency table.</rdfs:comment>
        <rdfs:label xml:lang="en">observed cell 01</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#cell10 -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#cell10">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceCountData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">Observed frequency O_10 in the 2x2 contingency table.</rdfs:comment>
        <rdfs:label xml:lang="en">observed cell 10</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#cell11 -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#cell11">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceCountData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">Observed frequency O_11 in the 2x2 contingency table.</rdfs:comment>
        <rdfs:label xml:lang="en">observed cell 11</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#chi2 -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#chi2">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/lemon/frac#cScore"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Dunning1993"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Evert2005"/>
        <rdfs:comment xml:lang="en">Locally declared FrAC-compatible datatype score property; absent from LexInfo. See its named measure resource for the precise formula and references.</rdfs:comment>
        <rdfs:label xml:lang="en">Pearson chi-squared association statistic</rdfs:label>
        <rdfs:label xml:lang="it">Statistica chi-quadrato di Pearson</rdfs:label>
        <denotesMeasure rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#ChiSquared"/>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#confidence -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#confidence">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/lemon/frac#cScore"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Agrawal1993"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#FrAC2025"/>
        <rdfs:comment xml:lang="en">Locally declared FrAC-compatible datatype score property; absent from LexInfo. See its named measure resource for the precise formula and references.</rdfs:comment>
        <rdfs:label xml:lang="en">Association-rule confidence</rdfs:label>
        <rdfs:label xml:lang="it">Confidenza della regola associativa</rdfs:label>
        <denotesMeasure rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#Confidence"/>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#cooccurrenceFrequency -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#cooccurrenceFrequency">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/lemon/frac#cScore"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Evert2005"/>
        <rdfs:comment xml:lang="en">Locally declared FrAC-compatible datatype score property; absent from LexInfo. See its named measure resource for the precise formula and references.</rdfs:comment>
        <rdfs:label xml:lang="it">Frequenza grezza di co-occorrenza</rdfs:label>
        <rdfs:label xml:lang="en">Raw co-occurrence frequency</rdfs:label>
        <denotesMeasure rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceFrequency"/>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#dice -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#dice">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/lemon/frac#cScore"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/frac#Collocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Evert2005"/>
        <dct:references rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures/bibliography#Rychly2008"/>
        <rdfs:comment xml:lang="en">Locally declared FrAC-compatible datatype score property; absent from LexInfo. See its named measure resource for the precise formula and references.</rdfs:comment>
        <rdfs:label xml:lang="it">Coefficiente Dice</rdfs:label>
        <rdfs:label xml:lang="en">Dice coefficient</rdfs:label>
        <denotesMeasure rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#Dice"/>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#expectedJointCount -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#expectedJointCount">
        <rdfs:domain rdf:resource="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#CooccurrenceCountData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">E11=fx*fy/N under an independence model with consistent 2x2 marginals.</rdfs:comment>
        <rdfs:label xml:lang="en">expected joint count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://ilc.cnr.it/klab/ontology/cooccurrence-measures#jointCount -->

    <owl:DatatypeProperty rdf:about="https://ilc.cnr.it/klab/ontology/cooccurrence-measures#jointCount">
